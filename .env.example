# Nextcloud Service Configuration
# This file is used by Quadlet via --env-file=./configs/nextcloud.env
# Ansible templates this from deployment-private/secrets/vars.yml

# Database
POSTGRES_ROOT_PASSWORD=<change-me>
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=<change-me>
PGDATA=/var/lib/postgresql/data/pgdata

# Application
REDIS_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com
TRUSTED_PROXIES=127.0.0.1 10.0.0.0/8
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=<change-me>

# PHP-FPM tuning
PHP_MAX_CHILDREN=20
PHP_START_SERVERS=5
PHP_MIN_SPARE_SERVERS=5
PHP_MAX_SPARE_SERVERS=10
PHP_MAX_REQUESTS=500
PHP_MAX_EXECUTION_TIME=3600
PHP_UPLOAD_LIMIT=15G
PHP_MEMORY_LIMIT=6G
PHP_MAX_FILE_UPLOADS=100

# notify_push (optional, requires custom image)
NEXTCLOUD_URL=https://cloud.example.com
