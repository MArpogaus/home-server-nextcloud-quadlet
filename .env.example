# Nextcloud Service Configuration
# Copy to .env and fill in secrets

# Database
DB_ROOT_PASSWORD=<change-me>
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=<change-me>
DB_DATA=/home/nextcloud/db/postgresql

# Application
APP_CONFIG=/home/nextcloud/config
APP_DATA=/home/nextcloud/data
APP_PORT=8001
NEXTCLOUD_TRUSTED_DOMAINS=cloud.arpogaus.de
NEXTCLOUD_URL=https://cloud.arpogaus.de

# Nextcloud Admin (uncomment for first-run setup)
# NEXTCLOUD_ADMIN_USER=admin
# NEXTCLOUD_ADMIN_PASSWORD=<change-me>
