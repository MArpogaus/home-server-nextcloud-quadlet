# Nextcloud Environment — templated by Ansible
# Source: deployment-private/secrets/vars.yml

# Database
POSTGRES_ROOT_PASSWORD={{ nextcloud_db_root_password }}
POSTGRES_DB={{ nextcloud_db_name | default('nextcloud') }}
POSTGRES_USER={{ nextcloud_db_user | default('nextcloud') }}
POSTGRES_PASSWORD={{ nextcloud_db_password }}
PGDATA=/var/lib/postgresql/data/pgdata

# Application
REDIS_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_trusted_domains | default('cloud.example.com') }}
TRUSTED_PROXIES={{ nextcloud_trusted_proxies | default('127.0.0.1 10.0.0.0/8') }}
NEXTCLOUD_ADMIN_USER={{ nextcloud_admin_user | default('admin') }}
NEXTCLOUD_ADMIN_PASSWORD={{ nextcloud_admin_password }}

# PHP-FPM
PHP_MAX_CHILDREN={{ nextcloud_php_max_children | default('20') }}
PHP_START_SERVERS={{ nextcloud_php_start_servers | default('5') }}
PHP_MIN_SPARE_SERVERS={{ nextcloud_php_min_spare_servers | default('5') }}
PHP_MAX_SPARE_SERVERS={{ nextcloud_php_max_spare_servers | default('10') }}
PHP_MAX_REQUESTS={{ nextcloud_php_max_requests | default('500') }}
PHP_MAX_EXECUTION_TIME={{ nextcloud_php_max_execution_time | default('3600') }}
PHP_UPLOAD_LIMIT={{ nextcloud_php_upload_limit | default('15G') }}
PHP_MEMORY_LIMIT={{ nextcloud_php_memory_limit | default('6G') }}
PHP_MAX_FILE_UPLOADS={{ nextcloud_php_max_file_uploads | default('100') }}
PHP_EMERGENCY_RESTART_THRESHOLD={{ nextcloud_php_emergency_restart_threshold | default('10') }}
PHP_EMERGENCY_RESTART_INTERVAL={{ nextcloud_php_emergency_restart_interval | default('1m') }}
PHP_PROCESS_CONTROL_TIMEOUT={{ nextcloud_php_process_control_timeout | default('10s') }}
NOTIFY_PUSH_ARCH={{ nextcloud_notify_push_arch }}

# notify_push (requires custom nextcloud image with notify_push binary)
NEXTCLOUD_URL={{ nextcloud_url | default('https://' + nextcloud_trusted_domains.split(',')[0] | trim) }}
