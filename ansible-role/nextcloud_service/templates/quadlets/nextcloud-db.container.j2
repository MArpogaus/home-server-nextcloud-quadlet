[Container]
Image=docker.io/library/postgres:15
ContainerName=nextcloud-db
EnvironmentFile=./configs/nextcloud.env
PodmanArgs=--volume=nc-db:/var/lib/postgresql/data:Z{{ ' ' + nextcloud_service_db_extra_args if nextcloud_service_db_extra_args else '' }}
Network=shared-network
AutoUpdate={{ nextcloud_service_auto_update }}

[Install]
WantedBy=default.target
