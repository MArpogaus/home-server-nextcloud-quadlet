# Nextcloud nginx configuration — templated by Ansible
# Reverse proxy to nextcloud-app:9000 (PHP-FPM)

user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
    multi_accept on;
    use epoll;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    keepalive_requests 10000;
    types_hash_max_size 2048;
    server_tokens off;

    client_max_body_size {{ nextcloud_max_body_size | default('15G') }};
    client_body_buffer_size 128k;
    client_body_timeout 3600s;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    #gzip  on;
    upstream php-handler {
        server nextcloud-app:9000;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name _;

        # HSTS (commented by default — enable after TLS is set up via Bunkerweb)
        #add_header Strict-Transport-Security "max-age=15768000; includeSubDomains; preload;" always;

        root /var/www/html;
        index index.php index.html /index.php$request_uri;

        location = / {
            if ( $http_host ~ ^(.*)$ ) {
                return 301 $scheme://$1/index.php$request_uri;
            }
        }

        location = /robots.txt {
            allow all;
            log_not_found off;
            access_log off;
        }

        location ^~ /.well-known {
            location = /.well-known/carddav { return 301 $scheme://$host/remote.php/dav; }
            location = /.well-known/caldav  { return 301 $scheme://$host/remote.php/dav; }
            location = /.well-known/webfinger  { return 301 $scheme://$host/index.php/.well-known/webfinger; }
            location = /.well-known/nodeinfo  { return 301 $scheme://$host/index.php/.well-known/nodeinfo; }
            try_files $uri $uri/ =404;
        }

        location ~ ^/(?:build|tests|config|lib|3rdparty|templates|data)(?:$|/)  { return 404; }
        location ~ ^/(?:\.|autotest|occ|issue|indie|db_|console)              { return 404; }

        location ~ \.php(?:$|/) {
            fastcgi_split_path_info ^(.+?\.php)(/.*)$;
            set $path_info $fastcgi_path_info;
            try_files $fastcgi_script_name =404;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $path_info;
            fastcgi_param HTTPS on;
            fastcgi_param modHeadersAvailable true;
            fastcgi_param front_controller_active true;
            fastcgi_pass php-handler;
            fastcgi_read_timeout 3600s;
            fastcgi_send_timeout 3600s;
            fastcgi_connect_timeout 3600s;
            fastcgi_index index.php;
            include fastcgi_params;
        }

        location ~ \.(?:css|js|svg|gif|png|jpg|ico|wasm|tflite|map)$ {
            try_files $uri /index.php$request_uri;
            add_header Cache-Control "public, max-age=15778463";
            add_header X-Content-Type-Options "nosniff" always;
            access_log off;
        }

        location ~ \.(?:ogg|mp3|mp4|m4a|wav|flac|avi|mov|avi|mpg|mpeg|mkv|webm)$ {
            try_files $uri /index.php$request_uri;
            add_header Cache-Control "public, max-age=15778463";
            access_log off;
        }

        location ~ \.(?:ttf|woff|woff2|eot)$ {
            try_files $uri /index.php$request_uri;
            add_header Cache-Control "public, max-age=15778463";
            access_log off;
        }

        location ~ \.(?:zip|tar|gz|bz2|rar|pdf|doc|xls|odt|ods|odp)$ {
            try_files $uri /index.php$request_uri;
            add_header Cache-Control "public, max-age=15778463";
            access_log off;
        }

        location / {
            try_files $uri $uri/ /index.php$request_uri;
        }
    }
}
