[Container]
Image={{ (nextcloud_image | default('docker.io/library/nextcloud:31-fpm')) | lower }}
ContainerName=nextcloud-cron
PodmanArgs={{ nextcloud_service_cron_extra_args }}
Volume=nc-app-html:/var/www/html:z
Volume=nc-app-apps:/var/www/html/custom_apps:z
Volume=nc-app-logs:/var/log/nextcloud:z
Volume={{ service_home }}/data/data:/var/www/html/data:idmap,z
Volume={{ service_home }}/data/config:/var/www/html/config:idmap,z
Pod=nc.pod
Exec=/cron.sh
AutoUpdate={{ nextcloud_service_auto_update }}

[Unit]
After=nextcloud-app.service

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
